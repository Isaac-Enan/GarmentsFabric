        min_cut_length_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        price_per_yard:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        quality_grade:
          $ref: '#/components/schemas/QualityGradeEnum'
        status:
          $ref: '#/components/schemas/StatusC50Enum'
        is_sample_available:
          type: boolean
        sample_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        primary_image:

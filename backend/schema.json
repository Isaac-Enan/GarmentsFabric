openapi: 3.0.3
info:
  title: FabriLink B2B Marketplace API
  version: 1.0.0
  description: Production API connecting garment factories with surplus fabric rolls
    to small boutiques and fashion startups in Bangladesh.
paths:
  /api/v1/auth/login/:
    post:
      operationId: auth_login_create
      description: Authenticate user with email and password.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: auth_logout_create
      description: Blacklist refresh token and clear authentication cookie.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LogoutRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LogoutRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LogoutRequestRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: Logged out successfully
  /api/v1/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: Get current authenticated user profile, roles, and company.
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
    patch:
      operationId: auth_me_partial_update
      description: Update profile attributes for current user.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
  /api/v1/auth/profile/:
    get:
      operationId: auth_profile_retrieve
      description: Get current authenticated user profile, roles, and company.
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
    patch:
      operationId: auth_profile_partial_update
      description: Update profile attributes for current user.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
  /api/v1/auth/register/:
    post:
      operationId: auth_register_create
      description: Register a new factory or buyer account.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserRegistrationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/UserRegistrationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/UserRegistrationRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
          description: ''
  /api/v1/auth/token/refresh/:
    post:
      operationId: auth_token_refresh_create
      description: Rotate refresh token from cookie and issue new access token.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequestRequest'
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: Refreshed access token
  /api/v1/catalog/categories/:
    get:
      operationId: catalog_categories_list
      tags:
      - catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/FabricCategory'
          description: ''
  /api/v1/catalog/rolls/:
    get:
      operationId: catalog_rolls_list
      parameters:
      - in: query
        name: category
        schema:
          type: string
      - in: query
        name: color
        schema:
          type: string
      - in: query
        name: fabric_type
        schema:
          type: string
      - in: query
        name: max_gsm
        schema:
          type: integer
      - in: query
        name: max_price
        schema:
          type: number
          format: double
      - in: query
        name: min_gsm
        schema:
          type: integer
      - in: query
        name: min_yards
        schema:
          type: number
          format: double
      - in: query
        name: search
        schema:
          type: string
      tags:
      - catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/FabricRollList'
          description: ''
  /api/v1/catalog/rolls/{roll_id}/:
    get:
      operationId: catalog_rolls_retrieve
      parameters:
      - in: path
        name: roll_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - catalog
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FabricRollDetail'
          description: ''
  /api/v1/companies/addresses/:
    get:
      operationId: companies_addresses_list
      tags:
      - companies
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CompanyAddress'
          description: ''
    post:
      operationId: companies_addresses_create
      tags:
      - companies
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CompanyAddressRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CompanyAddressRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CompanyAddressRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CompanyAddress'
          description: ''
  /api/v1/companies/admin/{company_id}/verify/:
    post:
      operationId: companies_admin_verify_create
      description: Approve or reject company KYC
      parameters:
      - in: path
        name: company_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - companies
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CompanyVerificationActionRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CompanyVerificationActionRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CompanyVerificationActionRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
  /api/v1/companies/admin/kyc-queue/:
    get:
      operationId: companies_admin_kyc_queue_list
      description: List companies pending KYC approval
      tags:
      - companies
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Company'
          description: ''
  /api/v1/companies/my-company/:
    get:
      operationId: companies_my_company_retrieve
      description: Get current user company details and verification status
      tags:
      - companies
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
    patch:
      operationId: companies_my_company_partial_update
      description: Update company KYC details and documents
      tags:
      - companies
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCompanyKYCUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedCompanyKYCUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedCompanyKYCUpdateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
  /api/v1/orders/:
    get:
      operationId: orders_list
      tags:
      - orders
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OrderDetail'
          description: ''
  /api/v1/orders/{order_id}/:
    get:
      operationId: orders_retrieve
      parameters:
      - in: path
        name: order_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - orders
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderDetail'
          description: ''
  /api/v1/orders/cart/:
    get:
      operationId: orders_cart_list
      tags:
      - orders
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CartItem'
          description: ''
    post:
      operationId: orders_cart_create
      tags:
      - orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CartItem'
          description: ''
  /api/v1/orders/cart/items/:
    get:
      operationId: orders_cart_items_list
      tags:
      - orders
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CartItem'
          description: ''
    post:
      operationId: orders_cart_items_create
      tags:
      - orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AddToCartRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CartItem'
          description: ''
  /api/v1/orders/cart/items/{item_id}/:
    delete:
      operationId: orders_cart_items_destroy
      parameters:
      - in: path
        name: item_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - orders
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/orders/checkout/:
    post:
      operationId: orders_checkout_create
      tags:
      - orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CheckoutRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CheckoutRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CheckoutRequestRequest'
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderDetail'
          description: ''
components:
  schemas:
    ActionEnum:
      enum:
      - APPROVE
      - REJECT
      - SUSPEND
      type: string
      description: |-
        * `APPROVE` - APPROVE
        * `REJECT` - REJECT
        * `SUSPEND` - SUSPEND
    AddToCartRequest:
      type: object
      properties:
        fabric_roll_id:
          type: string
          format: uuid
        requested_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
      required:
      - fabric_roll_id
      - requested_yards
    AddressTypeEnum:
      enum:
      - FACTORY_PREMISES
      - WAREHOUSE
      - BILLING
      - DELIVERY
      type: string
      description: |-
        * `FACTORY_PREMISES` - Factory Premises
        * `WAREHOUSE` - Warehouse
        * `BILLING` - Billing Address
        * `DELIVERY` - Delivery Address
    CartItem:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        fabric_roll:
          type: string
          format: uuid
        roll_code:
          type: string
          readOnly: true
        roll_title:
          type: string
          readOnly: true
        roll_color_name:
          type: string
          readOnly: true
        roll_color_hex:
          type: string
          readOnly: true
        roll_gsm:
          type: integer
          readOnly: true
        roll_width:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          readOnly: true
        roll_available_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        roll_min_cut:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
          readOnly: true
        requested_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        unit_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        item_subtotal:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - fabric_roll
      - id
      - item_subtotal
      - requested_yards
      - roll_available_yards
      - roll_code
      - roll_color_hex
      - roll_color_name
      - roll_gsm
      - roll_min_cut
      - roll_title
      - roll_width
      - unit_price
    CheckoutRequestRequest:
      type: object
      properties:
        payment_method:
          allOf:
          - $ref: '#/components/schemas/PaymentMethodEnum'
          default: BKASH
        delivery_notes:
          type: string
    Company:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        company_type:
          $ref: '#/components/schemas/CompanyTypeEnum'
        trade_license_number:
          type: string
          maxLength: 100
        tin_number:
          type: string
          maxLength: 50
        bin_number:
          type: string
          maxLength: 50
        trade_license_file:
          type: string
          format: uri
          nullable: true
        tin_file:
          type: string
          format: uri
          nullable: true
        bin_file:
          type: string
          format: uri
          nullable: true
        verification_status:
          allOf:
          - $ref: '#/components/schemas/VerificationStatusEnum'
          readOnly: true
        rejection_reason:
          type: string
          readOnly: true
        contact_email:
          type: string
          format: email
          maxLength: 254
        contact_phone:
          type: string
          maxLength: 20
        credit_limit:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          readOnly: true
        credit_terms_days:
          type: integer
          readOnly: true
        credit_status:
          allOf:
          - $ref: '#/components/schemas/CreditStatusEnum'
          readOnly: true
        addresses:
          type: array
          items:
            $ref: '#/components/schemas/CompanyAddress'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - addresses
      - company_type
      - contact_email
      - contact_phone
      - created_at
      - credit_limit
      - credit_status
      - credit_terms_days
      - id
      - name
      - rejection_reason
      - updated_at
      - verification_status
    CompanyAddress:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        company:
          type: string
          format: uuid
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        division:
          type: string
          maxLength: 50
        district:
          type: string
          maxLength: 50
        upazila_thana:
          type: string
          maxLength: 100
        street_address:
          type: string
        postal_code:
          type: string
          maxLength: 20
        landmark:
          type: string
          maxLength: 255
        gps_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
        gps_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
        is_default:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - address_type
      - company
      - created_at
      - district
      - division
      - id
      - postal_code
      - street_address
      - upazila_thana
    CompanyAddressRequest:
      type: object
      properties:
        company:
          type: string
          format: uuid
        address_type:
          $ref: '#/components/schemas/AddressTypeEnum'
        division:
          type: string
          minLength: 1
          maxLength: 50
        district:
          type: string
          minLength: 1
          maxLength: 50
        upazila_thana:
          type: string
          minLength: 1
          maxLength: 100
        street_address:
          type: string
          minLength: 1
        postal_code:
          type: string
          minLength: 1
          maxLength: 20
        landmark:
          type: string
          maxLength: 255
        gps_lat:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
        gps_lng:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,6})?$
          nullable: true
        is_default:
          type: boolean
      required:
      - address_type
      - company
      - district
      - division
      - postal_code
      - street_address
      - upazila_thana
    CompanyTypeEnum:
      enum:
      - FACTORY
      - BUYER
      type: string
      description: |-
        * `FACTORY` - Garment Factory / Mill
        * `BUYER` - Boutique / Brand / Startup
    CompanyVerificationActionRequest:
      type: object
      properties:
        action:
          $ref: '#/components/schemas/ActionEnum'
        rejection_reason:
          type: string
        credit_limit:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        credit_terms_days:
          type: integer
      required:
      - action
    CreditStatusEnum:
      enum:
      - INELIGIBLE
      - ELIGIBLE
      - ACTIVE
      - BLOCKED
      type: string
      description: |-
        * `INELIGIBLE` - Ineligible
        * `ELIGIBLE` - Eligible
        * `ACTIVE` - Active
        * `BLOCKED` - Blocked
    FabricCategory:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 100
        slug:
          type: string
          maxLength: 100
          pattern: ^[-a-zA-Z0-9_]+$
        description:
          type: string
        fabric_types:
          type: array
          items:
            $ref: '#/components/schemas/FabricType'
          readOnly: true
      required:
      - fabric_types
      - id
      - name
      - slug
    FabricRollDetail:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        roll_code:
          type: string
          maxLength: 50
        title:
          type: string
          maxLength: 255
        category_name:
          type: string
          readOnly: true
        fabric_type_name:
          type: string
          readOnly: true
        mill_name:
          type: string
          readOnly: true
        mill_contact_phone:
          type: string
          readOnly: true
        mill_location:
          type: string
          readOnly: true
        composition:
          type: string
          maxLength: 255
        gsm:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        width_inches:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        color_name:
          type: string
          maxLength: 100
        color_hex:
          type: string
          maxLength: 7
        pattern:
          type: string
          maxLength: 100
        finish:
          type: string
          maxLength: 100
        total_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        available_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        min_cut_length_yards:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        price_per_yard:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        lot_batch_number:
          type: string
          maxLength: 100
        quality_grade:
          $ref: '#/components/schemas/QualityGradeEnum'
        defect_notes:
          type: string
        status:
          $ref: '#/components/schemas/StatusC50Enum'
        is_sample_available:
          type: boolean
        sample_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        images:
          type: array
          items:
            $ref: '#/components/schemas/FabricRollImage'
